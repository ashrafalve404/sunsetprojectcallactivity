# Environment Configuration
# Copy this file to .env and fill in real values
# Never commit .env to version control

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Sunset Group Dashboard"
APP_VERSION="1.0.0"
DEBUG=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://sunset_user:strongpassword@localhost:5432/sunset_dashboard

# SQLite fallback (local dev — set DATABASE_URL to this for quick start)
# DATABASE_URL=sqlite:///./sunset_dashboard.db

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Business Configuration ───────────────────────────────────────────────────
BUSINESS_TIMEZONE=Asia/Dhaka

# ─── Cookie Security ──────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
